
Призначення:
Це шар домену (Domain Layer) — тут зберігаються тільки сутності (класи, які описують об’єкти бізнесу).
Жодної логіки, тільки дані.

Тут розташовані такі файли:

Client.cs — опис клієнта.

Policy.cs — опис страхового поліса.

Claim.cs — опис страхової події.

Client.cs:
namespace InsuranceCompany.Domain
{
    public class Client
    {
        public Guid Id { get; set; } = Guid.NewGuid(); 
        public string Name { get; set; } 
        public string Email { get; set; }
        public string Phone { get; set; }
        public string ClientType { get; set; }

        // Додано на етапі 2:
        public int PolicyCount { get; set; }     // Кількість оформлених клієнтом полісів
        public decimal TotalPayouts { get; set; } // Загальна сума виплачених страхових відшкодувань
    }
